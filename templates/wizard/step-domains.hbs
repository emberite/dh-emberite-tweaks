<p class="dhet-wz-counter {{#if (eq count max)}}full{{/if}}">{{localize "DHET.Wizard.Domains.Count" count=count max=max}}</p>
<div class="dhet-wz-domains-cols">
    {{#each columns}}
    <section class="dhet-wz-domain" style="--domain-color: {{color}}">
        <header class="dhet-wz-domain-head">
            {{#if banner}}<img class="dhet-wz-banner" src="{{banner}}" alt="" />{{else if icon}}<img class="dhet-wz-domain-icon" src="{{icon}}" alt="" />{{/if}}
            <h2>{{label}}</h2>
        </header>
        <div class="dhet-wz-cardgrid">
            {{#each cards}}{{> "modules/dh-emberite-tweaks/templates/wizard/_pick.hbs"}}{{/each}}
        </div>
    </section>
    {{/each}}
</div>
