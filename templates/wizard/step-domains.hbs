<p class="dhet-wz-counter {{#if (eq count max)}}full{{/if}}">{{localize "DHET.Wizard.Domains.Count" count=count max=max}}</p>
<div class="dhet-wz-domains-cols">
    {{#each columns}}
    <section class="dhet-wz-domain" style="--domain-color: {{color}}">
        <header class="dhet-wz-domain-head">
            {{#if banner}}<img class="dhet-wz-banner" src="{{banner}}" alt="" />{{else if icon}}<img class="dhet-wz-domain-icon" src="{{icon}}" alt="" />{{/if}}
            <h2>{{label}}</h2>
        </header>
        <div class="dhet-wz-grid dhet-wz-cards">
            {{#each cards}}
            <button type="button" class="dhet-wz-card dhet-wz-art-card {{#if selected}}selected{{/if}}" data-action="{{action}}" data-uuid="{{uuid}}"
                data-tooltip-html="{{tooltip}}" data-tooltip-class="dhet-tooltip" data-tooltip-direction="UP">
        {{#if selected}}<span class="dhet-wz-check"><i class="fa-solid fa-check"></i></span>{{/if}}
                <div class="dhet-wz-art">{{#if hasArt}}<img class="cover" src="{{img}}" alt="" />{{else}}<img class="icon" src="{{img}}" alt="" />{{/if}}</div>
                <div class="dhet-wz-card-text">
                    <strong>{{name}}</strong>
                    <span>{{#if type}}{{type}} · {{/if}}{{localize "DHET.Wizard.Domains.Recall" cost=recall}}</span>
                </div>
            </button>
            {{/each}}
        </div>
    </section>
    {{/each}}
</div>
