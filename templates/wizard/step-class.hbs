<div class="dhet-wz-classgroups">
    {{#each groups}}
    <section class="dhet-wz-classgroup {{#if selected}}selected{{/if}}">
        <header class="dhet-wz-classlabel" data-tooltip-html="{{tooltip}}" data-tooltip-class="dhet-tooltip" data-tooltip-direction="UP">
            <h2>{{name}}</h2>
            <span class="dhet-wz-domains">{{#each domainList}}<span class="dhet-wz-dom">{{#if icon}}<img src="{{icon}}" alt="" />{{/if}}{{label}}</span>{{/each}}</span>
            <span class="dhet-wz-stats"><i class="fa-solid fa-heart"></i> {{hp}} <i class="fa-solid fa-shield"></i> {{evasion}}</span>
        </header>
        <div class="dhet-wz-cardrow">
            {{#each subclasses}}{{> "modules/dh-emberite-tweaks/templates/wizard/_pick.hbs"}}{{/each}}
        </div>
    </section>
    {{/each}}
</div>
