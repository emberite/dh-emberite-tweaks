<div class="dhet-wz {{#if core}}dhet-core{{/if}}" style="{{themeStyle}}">
    <div class="dhet-wz-backdrop" {{#if backdrop}}style="background-image: url('{{backdrop}}')"{{/if}}></div>
    <div class="dhet-wz-vignette"></div>

    <nav class="dhet-wz-rail">
        <header class="dhet-wz-brand">
            <span class="dhet-wz-brand-kicker">{{localize "DHET.LevelUp.Kicker"}}</span>
            <span class="dhet-wz-brand-name">{{actorName}}</span>
        </header>
        {{#if levels}}
        <ol class="dhet-wz-steps">
            {{#each levels}}
            <li>
                <button type="button" class="dhet-wz-step {{#if current}}current{{/if}} {{#if done}}done{{/if}}" data-action="gotoLevel" data-level="{{level}}" {{#if locked}}disabled{{/if}}>
                    <span class="dhet-wz-step-num">{{#if done}}<i class="fa-solid fa-check"></i>{{else}}{{level}}{{/if}}</span>
                    <span class="dhet-wz-step-label">{{localize "DHET.LevelUp.Level" level=level}}</span>
                </button>
            </li>
            {{/each}}
            <li>
                <button type="button" class="dhet-wz-step {{#if reviewing}}current{{/if}}" disabled>
                    <span class="dhet-wz-step-num"><i class="fa-solid fa-flag-checkered"></i></span>
                    <span class="dhet-wz-step-label">{{localize "DHET.LevelUp.Review"}}</span>
                </button>
            </li>
        </ol>
        {{/if}}
        <div class="dhet-wz-sofar">
            {{#if portrait}}<img class="dhet-wz-sofar-portrait" src="{{portrait}}" alt="" />
            {{else if cutout}}<img class="dhet-wz-sofar-cutout" src="{{cutout}}" alt="" />{{else if backdrop}}<img class="dhet-wz-sofar-art" src="{{backdrop}}" alt="" />{{/if}}
            <span>{{className}} · {{subclassName}}</span>
            <span>{{localize "DHET.LevelUp.Level" level=currentLevel}}</span>
        </div>
    </nav>

    <main class="dhet-wz-main">
        <header class="dhet-wz-head">
            <div>
                {{#if choosing}}
                <h1>{{localize "DHET.LevelUp.ChooseTitle"}}</h1>
                <p>{{localize "DHET.LevelUp.ChooseHint"}}</p>
                {{else if reviewing}}
                <h1>{{localize "DHET.LevelUp.ReviewTitle"}}</h1>
                <p>{{localize "DHET.LevelUp.ReviewHint"}}</p>
                {{else}}
                <h1>{{localize "DHET.LevelUp.Level" level=level}} <span class="dhet-wz-tier">{{tierName}}</span></h1>
                <p>{{localize "DHET.LevelUp.LevelHint" count=maxSelections}}</p>
                {{/if}}
            </div>
            <button type="button" class="dhet-wz-close" data-action="close" data-tooltip="{{localize 'DHET.Wizard.Close'}}"><i class="fa-solid fa-xmark"></i></button>
        </header>

        <section class="dhet-wz-body">
            {{#if choosing}}
            <div class="dhet-wz-grid dhet-wz-targets">
                {{#each targets}}
                <button type="button" class="dhet-wz-card dhet-wz-target {{#if newTier}}new-tier{{/if}}" data-action="target" data-level="{{level}}">
                    <span class="dhet-wz-target-num">{{level}}</span>
                    <span class="dhet-wz-muted">{{tier}}</span>
                    {{#if newTier}}<span class="dhet-wz-badge">{{localize "DHET.LevelUp.NewTier"}}</span>{{/if}}
                </button>
                {{/each}}
            </div>

            {{else if reviewing}}
            <div class="dhet-wz-review-levels">
                {{#each summary}}
                <section class="dhet-wz-review-level">
                    <div class="dhet-wz-review-level-text">
                        <h3>{{localize "DHET.LevelUp.Level" level=level}}</h3>
                        <ul>{{#each lines}}<li>{{this}}</li>{{/each}}</ul>
                    </div>
                    {{#if cards.length}}<div class="dhet-wz-hand">{{#each cards}}<div class="dhet-wz-hand-card">{{{this}}}</div>{{/each}}</div>{{/if}}
                </section>
                {{/each}}
            </div>

            {{else}}
            {{#if achievements.experiences.length}}
            <h2 class="dhet-wz-subhead">{{localize "DHET.LevelUp.Achievements"}}</h2>
            <div class="dhet-wz-achievements">
                {{#each achievements.experiences}}
                <label class="dhet-wz-experience">
                    <span class="dhet-wz-exp-badge">+{{modifier}}</span>
                    <input type="text" value="{{name}}" placeholder="{{localize 'DHET.LevelUp.NewExperience'}}" data-dhet-input="newExperience:{{id}}" />
                </label>
                {{/each}}
                {{#if achievements.proficiency}}<p class="dhet-wz-note"><i class="fa-solid fa-hand-fist"></i> {{localize "DHET.LevelUp.ProficiencyUp"}}</p>{{/if}}
                <p class="dhet-wz-note"><i class="fa-solid fa-eraser"></i> {{localize "DHET.LevelUp.TraitsCleared"}}</p>
            </div>
            {{/if}}

            <h2 class="dhet-wz-subhead">{{localize "DHET.LevelUp.Advancements"}} <span class="dhet-wz-counter-inline {{#unless available}}full{{/unless}}">{{localize "DHET.LevelUp.Left" available=available max=maxSelections}}</span></h2>
            <div class="dhet-wz-options">
                {{#each options}}
                <div class="dhet-wz-option {{#if taken}}taken{{/if}} {{#unless canTake}}{{#unless taken}}spent{{/unless}}{{/unless}}">
                    <button type="button" class="dhet-wz-option-main" data-action="option" data-option="{{key}}" data-nr="{{nextNr}}" {{#unless canTake}}aria-disabled="true"{{/unless}}>
                        <i class="{{icon}}"></i>
                        <span class="dhet-wz-option-label">{{label}}</span>
                        <span class="dhet-wz-pips">{{#each pips}}<span class="{{#if mine}}mine{{else if selected}}used{{else if locked}}used{{/if}}"></span>{{/each}}</span>
                        {{#if (gt cost 1)}}<span class="dhet-wz-cost">{{localize "DHET.LevelUp.Cost" cost=cost}}</span>{{/if}}
                    </button>
                    {{#if taken}}
                    <button type="button" class="dhet-wz-icon" data-action="unoption" data-option="{{key}}" data-nr="{{lastNr}}" data-tooltip="{{localize 'DHET.LevelUp.Undo'}}"><i class="fa-solid fa-rotate-left"></i></button>
                    {{/if}}
                </div>
                {{/each}}
            </div>

            {{#each details}}
            <h2 class="dhet-wz-subhead"><i class="{{icon}}"></i> {{label}}</h2>
            {{#if traits}}
            <div class="dhet-wz-trait-row">
                {{#each traits}}
                <button type="button" class="dhet-wz-chip big {{#if selected}}selected{{/if}}" data-action="pickTrait" data-path="{{../path}}" data-trait="{{key}}" {{#if disabled}}disabled data-tooltip="{{localize 'DHET.LevelUp.Marked'}}"{{/if}}>
                    {{label}} <small>{{value}}</small>
                </button>
                {{/each}}
                <span class="dhet-wz-muted">{{count}}/{{amount}}</span>
            </div>
            {{/if}}
            {{#if experiences}}
            <div class="dhet-wz-trait-row">
                {{#each experiences}}
                <button type="button" class="dhet-wz-chip big {{#if selected}}selected{{/if}}" data-action="pickExperience" data-path="{{../path}}" data-id="{{id}}">{{name}} <small>+{{value}}</small></button>
                {{/each}}
                <span class="dhet-wz-muted">{{count}}/{{amount}}</span>
            </div>
            {{/if}}
            {{#if upgrades}}
            {{!-- Same column structure as the domain card galleries, so the cards come out the same size. --}}
            <div class="dhet-wz-domains-cols">
                <section class="dhet-wz-domain">
                    <div class="dhet-wz-cardgrid">
                        {{#each upgrades}}{{> "modules/dh-emberite-tweaks/templates/wizard/_pick.hbs"}}{{/each}}
                    </div>
                </section>
            </div>
            {{/if}}
            {{#if multiclass}}
            {{#if chosen}}
            <div class="dhet-wz-trait-row">
                <strong class="dhet-wz-chosen">{{chosen.name}}</strong>
                {{#each domains}}
                <button type="button" class="dhet-wz-chip big {{#if selected}}selected{{/if}}" data-action="pickMultiDomain" data-path="{{../path}}" data-domain="{{id}}" {{#if disabled}}disabled{{/if}}>
                    {{#if icon}}<img src="{{icon}}" alt="" />{{/if}} {{label}}
                </button>
                {{/each}}
            </div>
            {{/if}}
            <div class="dhet-wz-classgroups">
                {{#each groups}}
                <section class="dhet-wz-classgroup {{#if selected}}selected{{/if}}">
                    <header class="dhet-wz-classlabel">
                        <h2>{{name}}</h2>
                        <span class="dhet-wz-domains">{{#each domainList}}<span class="dhet-wz-dom">{{#if icon}}<img src="{{icon}}" alt="" />{{/if}}{{label}}</span>{{/each}}</span>
                    </header>
                    <div class="dhet-wz-cardrow">{{#each subclasses}}{{> "modules/dh-emberite-tweaks/templates/wizard/_pick.hbs"}}{{/each}}</div>
                </section>
                {{/each}}
            </div>
            {{/if}}
            {{/each}}

            {{#with achievements.cards}}
            <h2 class="dhet-wz-subhead">{{#if (gt max 1)}}{{localize "DHET.LevelUp.NewCards"}}{{else}}{{localize "DHET.LevelUp.NewCard"}}{{/if}}
                <span class="dhet-wz-counter-inline {{#if filled}}full{{/if}}">{{localize "DHET.LevelUp.CardsChosen" count=count max=max}}</span></h2>
            <div class="dhet-wz-domains-cols">{{> "modules/dh-emberite-tweaks/templates/wizard/_cardgallery.hbs" domains=domains}}</div>
            {{/with}}
            {{/if}}
        </section>

        <footer class="dhet-wz-foot">
            <button type="button" class="dhet-wz-btn ghost" data-action="back" {{#unless canBack}}{{#unless reviewing}}disabled{{/unless}}{{/unless}}>
                <i class="fa-solid fa-arrow-left"></i> {{localize "DHET.Wizard.Back"}}
            </button>
            {{#if reviewing}}
            <button type="button" class="dhet-wz-btn primary" data-action="finish" {{#unless canFinish}}disabled{{/unless}}>
                <i class="fa-solid fa-angles-up"></i> {{localize "DHET.LevelUp.Finish"}}
            </button>
            {{else if choosing}}
            <span></span>
            {{else}}
            <button type="button" class="dhet-wz-btn primary" data-action="next" {{#unless canNext}}disabled{{/unless}}>
                {{#if isLastLevel}}{{localize "DHET.LevelUp.ToReview"}}{{else}}{{localize "DHET.LevelUp.NextLevel"}}{{/if}} <i class="fa-solid fa-arrow-right"></i>
            </button>
            {{/if}}
        </footer>
    </main>

    <div class="dhet-wz-confirm" role="dialog">
        <div class="dhet-wz-confirm-box">
            <h2>{{localize "DHET.LevelUp.CloseTitle"}}</h2>
            <p>{{localize "DHET.LevelUp.CloseConfirm"}}</p>
            <div>
                <button type="button" class="dhet-wz-btn ghost" data-action="cancelClose">{{localize "DHET.Wizard.KeepGoing"}}</button>
                <button type="button" class="dhet-wz-btn primary" data-action="close" data-confirmed="true">{{localize "DHET.Wizard.Leave"}}</button>
            </div>
        </div>
    </div>
</div>
