<div class="dhet-wz-experiences">
    {{#each experiences}}
    <div class="dhet-wz-experience-block">
        <label class="dhet-wz-experience">
            <span class="dhet-wz-exp-badge">+2</span>
            <input type="text" value="{{name}}" placeholder="{{localize 'DHET.Wizard.Experiences.Placeholder' number=number}}" data-dhet-input="experience:{{id}}" />
        </label>
        <textarea class="dhet-wz-exp-desc" rows="2" placeholder="{{localize 'DHET.Wizard.Experiences.DescriptionPlaceholder'}}" data-dhet-input="experienceDescription:{{id}}">{{description}}</textarea>
    </div>
    {{/each}}
    <p class="dhet-wz-muted">{{examples}}</p>
</div>
