<div class="dhet-wz-toolbar">
    <button type="button" class="dhet-wz-toggle {{#if mixed}}on{{/if}}" data-action="toggleMixed">
        <i class="fa-solid {{#if mixed}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i> {{localize "DHET.Wizard.Ancestry.Mixed"}}
    </button>
    {{#if mixed}}
    <span class="dhet-wz-muted">{{localize "DHET.Wizard.Ancestry.MixedHint"}}</span>
    <label class="dhet-wz-inline">
        <span>{{localize "DHET.Wizard.Ancestry.Name"}}</span>
        <input type="text" value="{{ancestryName}}" placeholder="{{ancestryNamePlaceholder}}" data-dhet-input="ancestryName" />
    </label>
    {{/if}}
</div>
<div class="dhet-wz-grid dhet-wz-wide">
    {{#each ancestries}}
    <button type="button" class="dhet-wz-card dhet-wz-art-card {{#if selected}}selected{{/if}} {{#if second}}selected second{{/if}}"
        data-action="{{action}}" data-uuid="{{uuid}}" data-tooltip-html="{{tooltip}}" data-tooltip-class="dhet-tooltip" data-tooltip-direction="UP">
        {{#if selected}}<span class="dhet-wz-check"><i class="fa-solid fa-check"></i></span>{{/if}}
        <div class="dhet-wz-art">{{#if hasArt}}<img class="cover" src="{{img}}" alt="" />{{else}}<img class="icon" src="{{img}}" alt="" />{{/if}}</div>
        <div class="dhet-wz-card-text">
            <strong>{{name}}</strong>
            {{#if ../mixed}}{{#if selected}}{{#unless second}}<span class="dhet-wz-badge">{{localize "DHET.Wizard.Ancestry.First"}}</span>{{/unless}}{{/if}}
            {{#if second}}<span class="dhet-wz-badge">{{localize "DHET.Wizard.Ancestry.Second"}}</span>{{/if}}{{/if}}
        </div>
    </button>
    {{/each}}
</div>
