{{#each domains}}
<section class="dhet-wz-domain">
    <header class="dhet-wz-domain-head small">
        {{#if banner}}<img class="dhet-wz-banner" src="{{banner}}" alt="" />{{else if icon}}<img class="dhet-wz-domain-icon" src="{{icon}}" alt="" />{{/if}}
        <h2>{{label}}</h2>
    </header>
    <div class="dhet-wz-grid dhet-wz-cards">
        {{#each cards}}
        <button type="button" class="dhet-wz-card dhet-wz-art-card {{#if selected}}selected{{/if}}" data-action="pickCard" data-slot="{{slot}}" data-uuid="{{uuid}}"
            data-tooltip-html="{{tooltip}}" data-tooltip-class="dhet-tooltip" data-tooltip-direction="UP">
            {{#if selected}}<span class="dhet-wz-check"><i class="fa-solid fa-check"></i></span>{{/if}}
            <div class="dhet-wz-art">{{#if hasArt}}<img class="cover" src="{{img}}" alt="" />{{else}}<img class="icon" src="{{img}}" alt="" />{{/if}}</div>
            <div class="dhet-wz-card-text"><strong>{{name}}</strong><span>{{localize "DHET.LevelUp.CardLevel" level=level}}</span></div>
        </button>
        {{/each}}
    </div>
</section>
{{else}}
<p class="dhet-wz-muted">{{localize "DHET.LevelUp.NoCards"}}</p>
{{/each}}
