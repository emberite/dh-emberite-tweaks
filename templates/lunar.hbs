<div class="dhet-moon dhet-moon-{{#if phase}}{{phase}}{{else}}none{{/if}}">
    <svg class="dhet-moon-disc" viewBox="0 0 40 40" aria-hidden="true">
        <defs>
            <radialGradient id="{{svgId}}-lit" cx="40%" cy="35%" r="70%">
                <stop offset="0%" stop-color="#fffbea" />
                <stop offset="65%" stop-color="#efe5c3" />
                <stop offset="100%" stop-color="#cbbd8f" />
            </radialGradient>
            <radialGradient id="{{svgId}}-dark" cx="45%" cy="40%" r="70%">
                <stop offset="0%" stop-color="#3a3946" />
                <stop offset="100%" stop-color="#1d1c25" />
            </radialGradient>
            {{#if litPath}}<clipPath id="{{svgId}}-clip"><path d="{{litPath}}" /></clipPath>{{/if}}
        </defs>
        <circle class="dhet-moon-dark" cx="20" cy="20" r="18" fill="url(#{{svgId}}-dark)" />
        {{#if litPath}}
        <path class="dhet-moon-lit" d="{{litPath}}" fill="url(#{{svgId}}-lit)" />
        <g class="dhet-moon-craters" clip-path="url(#{{svgId}}-clip)">
            <circle cx="14" cy="13" r="3.2" />
            <circle cx="26" cy="11" r="1.8" />
            <circle cx="25" cy="24" r="4" />
            <circle cx="12" cy="26" r="2.2" />
            <circle cx="19" cy="32" r="1.6" />
        </g>
        {{/if}}
        <circle class="dhet-moon-rim" cx="20" cy="20" r="18" />
    </svg>
    <div class="dhet-moon-text">
        <strong>{{phaseLabel}}{{#if value}} <span class="dhet-muted">({{value}})</span>{{/if}}</strong>
        <span>{{phaseEffect}}</span>
    </div>
</div>
<ol class="dhet-phases">
    {{#each phases}}<li class="{{#if active}}active{{/if}}" data-tooltip="{{effect}}">{{label}}</li>{{/each}}
</ol>
<div class="dhet-actions">
    <button type="button" data-dhet-action="rollMoon" data-tooltip="{{localize 'DHET.Lunar.RollHint'}}">
        <i class="fa-solid fa-dice-d6"></i> {{localize "DHET.Lunar.Roll"}}
    </button>
    <button type="button" data-dhet-action="advanceMoon" {{#unless value}}aria-disabled="true"{{/unless}}
        data-tooltip="{{localize 'DHET.Lunar.AdvanceHint'}}">
        <i class="fa-solid fa-forward"></i> {{localize "DHET.Lunar.Advance"}}{{#if next}} → {{next}}{{/if}}
    </button>
</div>
